__DEVICE__ PGValue pg_decode_target(float3 q,float3 wc,PGViewing view) {
    return pg_decode_reference(q,make_float3(q.x,0.0f,0.0f),wc,view);
}
__DEVICE__ PGValue pg_core(float3 v,float3 n,PGModel m,int level) {
    PGValue input=pg_cam_cones(n,m.view);if(input.valid==0)return pg_value(v,0);
    PGValue tone=pg_stage2_appearance(input.v,input.ja,m);float3 q=tone.v;
    float3 reference=q;
    if(level==2)q=pg_stage3_ja(q,tone.ja,m);
    if(q.x==input.v.x && q.y==input.v.y && q.z==input.v.z)return pg_value(v,1);
    PGValue out=pg_decode_reference(q,reference,m.wc,m.view);
    return out.valid?out:pg_value(v,0);
}
__DEVICE__ PGValue pg_nonlinear_eval(float3 v,PGModel m) {
    // Status: 2 full grade, 1 stage-2-only fallback, 0 unchanged stage-1 XYZ.
    if(m.active==0)return pg_value(v,2);
    float3 n=pg_normalized_cones(v,m.wc);
    float lift=_fmaxf(0.0f,-_fminf(n.x,_fminf(n.y,n.z)));
    float3 offset=m.wd*lift,offsetCones=make_float3(lift,lift,lift),lifted=n+offsetCones;
    if(lift>0.0f) {
        if(_fabs(lifted.x)<=4.0e-7f*(_fabs(n.x)+lift))lifted.x=0.0f;
        if(_fabs(lifted.y)<=4.0e-7f*(_fabs(n.y)+lift))lifted.y=0.0f;
        if(_fabs(lifted.z)<=4.0e-7f*(_fabs(n.z)+lift))lifted.z=0.0f;
    }
    for(int level=2;level>=1;level--) {
        PGValue a=pg_core(v+offset,lifted,m,level);
        if(a.valid==0)continue;
        if(lift==0.0f)return pg_value(a.v,level);
        PGValue b=pg_core(offset,offsetCones,m,level);
        if(b.valid==0)continue;
        // White-offset extension G(v+dW)-G(dW)+G(0), where G(0)=0.
        // Both terms always use the SAME fallback level.
        float3 result=a.v-b.v;
        if(pg_finite3(result))return pg_value(result,level);
    }
    return pg_value(v,0);
}
__DEVICE__ float3 pg_nonlinear(float3 v,PGModel m) { return pg_nonlinear_eval(v,m).v; }
__DEVICE__ float3 pg_linear(float3 xyz,PGModel m) {
    if(m.linearActive==0)return xyz;
    float sc=_fmaxf(_fabs(xyz.x),_fmaxf(_fabs(xyz.y),_fabs(xyz.z)));
    if(sc==0.0f)return xyz;
    return pg_mv(m.lin,pg_mv(m.adapt,xyz/sc))*sc*m.exposure;
