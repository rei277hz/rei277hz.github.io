// Fixed engineering constants, shared with the extension; no image fitting.
#define PG_HK_KNEE 1.0f
#define PG_HK_H_LIFT 0.20f
#define PG_HK_ENERGY_POWER 0.25f
__DEVICE__ float pg_chroma(float3 q) {
    float m=_fmaxf(_fabs(q.y),_fabs(q.z));
    if(m==0.0f)return 0.0f;
    float a=q.y/m,b=q.z/m;return m*_sqrtf(a*a+b*b);
}
__DEVICE__ float pg_achromatic_square(float H,float C) {
    float chromatic=66.0f*C;
    return _fmaf(H,H,-chromatic)-_fmaf(66.0f,C,-chromatic);
}
__DEVICE__ float pg_hk_energy(float3 q,float3 reference) {
    float C=pg_chroma(q),D=pg_achromatic_square(q.x,C);
    if(!pg_finite3(q) || q.x<0.0f || !pg_finite(C))return D;
    float E0=_fmaxf(0.0f,pg_achromatic_square(reference.x,pg_chroma(reference)));
    float h2=q.x*q.x,lo=_fminf(E0,h2),hi=_fmaxf(E0,h2);
    float delta=hi>0.0f?PG_HK_KNEE*lo/(1.0f+lo/hi):0.0f;
    if(D>=delta)return D;
    if(delta==0.0f)return 0.0f;
    // E=delta/(1+4*t+10*t*t)^(1/4), evaluated in bounded v=1/(1+t).
    float v=delta/(delta+_fmaxf(0.0f,delta-D));
    float u=1.0f-v;
    return delta*_sqrtf(v)/_sqrtf(_sqrtf(v*v+4.0f*v*u+10.0f*u*u));
}
__DEVICE__ float3 pg_project_energy(float3 q,float E) {
    float C=pg_chroma(q),D=pg_achromatic_square(q.x,C);
    if(!pg_finite3(q) || q.x<0.0f || !(E>D))return q;
    float X=q.x*q.x,Z=_fmaxf(E-D,0.0f);
    float cap=1.0f+PG_HK_H_LIFT,L=(cap*cap-1.0f)*X;
    float m=_fmaxf(2.0f*L,Z),G=0.0f;
    if(m>0.0f) {
        float l=2.0f*L/m,z=Z/m;
        G=L*z/_sqrtf(l*l+z*z);
    }
    float Cout=_fminf(C,_fmaxf(0.0f,(X+G-E)/66.0f)),gain=C>0.0f?Cout/C:1.0f;
    q.x=_sqrtf(_fmaxf(0.0f,X+G));q.y*=gain;q.z*=gain;
