}
__DEVICE__ float3 pg_project_reference(float3 q,float3 reference) {
    return pg_project_energy(q,pg_hk_energy(q,reference));
}
__DEVICE__ float3 pg_project_hk(float3 q) {
    return pg_project_reference(q,make_float3(q.x,0.0f,0.0f));
}
__DEVICE__ PGValue pg_decode_reference(float3 q,float3 reference,float3 wc,PGViewing view) {
    // Carry J_A^2 into the inverse: recomputing H^2-66C loses it near the edge.
    float E=pg_hk_energy(q,reference);
