// Derived from CIE 2019, DOI 10.25039/CIE.DS.xvudnb9b.
#define PG_LOCUS_COUNT 66
__DEVICE__ float3 pg_locus(int i) {
    if(i==0)return make_float3(0.174112234f,0.004963726f,0.0f);
    if(i==1)return make_float3(0.174007918f,0.004980549f,0.0f);
    if(i==2)return make_float3(0.173800773f,0.004915412f,0.0f);
    if(i==3)return make_float3(0.173559907f,0.004923203f,0.0f);
    if(i==4)return make_float3(0.173336865f,0.004796743f,0.0f);
    if(i==5)return make_float3(0.173020965f,0.004775050f,0.0f);
    if(i==6)return make_float3(0.172576551f,0.004799302f,0.0f);
    if(i==7)return make_float3(0.172086631f,0.004832524f,0.0f);
    if(i==8)return make_float3(0.171407434f,0.005102171f,0.0f);
    if(i==9)return make_float3(0.170300989f,0.005788505f,0.0f);
    if(i==10)return make_float3(0.168877521f,0.006900244f,0.0f);
    if(i==11)return make_float3(0.166895290f,0.008555606f,0.0f);
    if(i==12)return make_float3(0.164411756f,0.010857558f,0.0f);
