__DEVICE__ float3 pg_grade(float3 xyz,PGModel m) { return pg_nonlinear(pg_linear(xyz,m),m); }
__DEVICE__ float3 pg_rgb_xyz(float3 v) {
    return pg_mv(pg_mat(make_float3(.4123907993f,.3575843394f,.1804807884f),make_float3(.2126390059f,.7151686788f,.0721923154f),make_float3(.0193308187f,.1191947798f,.9505321522f)),v);
}
__DEVICE__ float3 pg_xyz_rgb(float3 v) {
    return pg_mv(pg_mat(make_float3(3.2409699419f,-1.5373831776f,-.4986107603f),make_float3(-.9692436363f,1.8759675015f,.0415550574f),make_float3(.0556300797f,-.2039769589f,1.0569715142f)),v);
}
__DEVICE__ float pg_decode(float v) { if(v<=.04045f)return v/12.92f; return _powf((v+.055f)/1.055f,2.4f); }
__DEVICE__ float pg_encode(float v) { if(v<=.0031308f)return 12.92f*v; return 1.055f*_powf(v,1.0f/2.4f)-.055f; }
__DEVICE__ float3 pg_palette(float3 rgb,float3 wd) {
    float3 lin=make_float3(pg_decode(rgb.x),pg_decode(rgb.y),pg_decode(rgb.z));
    return pg_adapt(pg_rgb_xyz(lin),pg_white(0,0.0f,0.0f),wd);
