                          PGFour radiusC,PGFour radiusQ,PGFour radiusA,PGFour radiusB,int chromaFit,
                          PGFour hueHeights,PGFour concentrationAHeights,PGFour concentrationBHeights,int hueFit,float radiusStops,float hueC,float hueQ,
